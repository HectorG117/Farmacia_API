{
  "info": {
    "name": "Farmacia API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "1) Ejecuta Auth > Login (guarda el token solo). 2) Usa las demás peticiones. Ajusta los IDs en la pestaña Variables de la colección."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
