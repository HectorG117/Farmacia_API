    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "nombre_usuario",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "medico_id",
      "value": "1"
    },
    {
      "key": "paciente_id",
      "value": "1"
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "cita_id",
      "value": "1"
    },
    {
      "key": "expediente_id",
      "value": "1"
    },
