            "body": {
              "mode": "raw",
              "raw": "{\n  \"medico_id\": \"{{medico_id}}\",\n  \"paciente_id\": \"{{paciente_id}}\",\n  \"fecha_emision\": \"2026-10-24\",\n  \"diagnostico\": \"Migra\u00f1a tensional\",\n  \"indicaciones_generales\": \"Reposo y buena hidrataci\u00f3n\",\n  \"estado\": \"Vigente\",\n  \"productos\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 2,\n      \"dosis\": \"1 tableta de 500 mg\",\n      \"frecuencia\": \"Cada 8 horas\",\n      \"duracion\": \"Durante 5 d\u00edas\",\n      \"instrucciones\": \"Tomar despu\u00e9s de los alimentos\"\n    }\n  ]\n}",
              "options": {
