{
  "info": {
    "name": "Farmacia API - Roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Un controlador y un token por rol (Admin, Médico, Paciente). 1) Ejecuta el Login del rol (guarda su token solo). 2) Usa las demás peticiones de esa carpeta. El token de un rol no funciona en las rutas de otro (403). Ajusta correos, contraseñas e IDs en la pestaña Variables."
  },
  "item": [
    {
      "name": "Admin",
      "description": "Login con nombre_usuario. El CRUD de médicos, citas, expedientes y recetas está en la colección \"Farmacia API\" (usa este mismo token).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token_admin}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"{{admin_usuario}}\",\n  \"password\": \"{{admin_password}}\",\n  \"dispositivo\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('token_admin', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/perfil",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "perfil"
              ]
            }
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token_admin', '');"
                ]
              }
            }
          ]
        }
      ]
    },
